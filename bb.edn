{:paths ["tasks" "test"]

 :tasks
 {:requires ([depends :as dep]
             [fly])

  ;; --- dependency checks (private; hidden from `bb tasks`) ---

  flyctl:installed
  {:private true
   :task    (dep/require-cli! "flyctl" "https://fly.io/docs/flyctl/install/")}

  flyctl:authed
  {:private true
   :depends [flyctl:installed]
   :task    (fly/require-authed!)}

  fly:app-exists
  {:private true
   :depends [flyctl:authed]
   :task    (fly/require-app! (fly/default-app-name) "Run `bb fly:init` to create it")}

  docker:installed
  {:private true
   :task    (dep/require-cli! "docker" "https://docs.docker.com/get-docker/")}

  ;; --- user-facing tasks ---

  repl     {:doc              "Start a Clojure REPL with dev + test on the classpath"
            :override-builtin true
            :task             (dep/sh! "clojure" "-M:dev:test")}

  dev      {:doc  "Run the app with the dev profile"
            :task (dep/sh! "clojure" "-M:dev")}

  lint     {:doc  "Lint with clj-kondo"
            :task (dep/sh! "clojure" "-M:lint")}

  fmt      {:doc  "Check formatting with cljfmt"
            :task (dep/sh! "clojure" "-M:cljfmt" "check")}

  fmt:fix  {:doc  "Fix formatting with cljfmt"
            :task (dep/sh! "clojure" "-M:cljfmt" "fix")}

  test     {:doc  "Run tests with kaocha"
            :task (dep/sh! "clojure" "-M:test")}

  test:tasks {:doc  "Run tests for the bb task infrastructure"
              :task ((requiring-resolve 'test-runner/run-tests))}

  ci       {:doc     "Lint + fmt-check + all tests"
            :depends [lint fmt test test:tasks]}

  build    {:doc  "Build an uberjar"
            :task (dep/sh! "clojure" "-T:build" "uberjar")}

  image    {:doc     "Build a container image"
            :depends [docker:installed build]
            :task    (dep/sh! "docker" "build" "-t" "reader:latest" ".")}

  deploy   {:doc     "Deploy to fly.io"
            :depends [fly:app-exists]
            :task    (dep/sh! "flyctl" "deploy" "--remote-only")}

  fly:init {:doc     "Create the Fly.io app for this project (one-time setup)"
            :depends [flyctl:authed]
            :task    (fly/init!)}}}
