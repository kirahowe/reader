{:paths ["src" "resources"]

 :deps {org.clojure/clojure                {:mvn/version "1.12.4"}
        integrant/integrant                {:mvn/version "1.0.1"}
        meta-merge/meta-merge              {:mvn/version "1.0.0"}
        http-kit/http-kit                  {:mvn/version "2.9.0-beta3"} ; >= 2.9 beta: SSE support for Datastar
        metosin/malli                      {:mvn/version "0.20.1"}
        metosin/reitit                     {:mvn/version "0.10.1"}
        hiccup/hiccup                      {:mvn/version "2.0.0"}
        com.taoensso/telemere              {:mvn/version "1.2.1"}
        com.taoensso/telemere-slf4j        {:mvn/version "1.2.1"}
        org.clojure/tools.logging          {:mvn/version "1.3.0"}
        org.slf4j/slf4j-api                {:mvn/version "2.0.17"}
        org.clojure/core.cache             {:mvn/version "1.2.263"}
        org.clojure/core.async             {:mvn/version "1.9.865"}
        com.github.seancorfield/next.jdbc  {:mvn/version "1.3.1108"}
        com.github.seancorfield/honeysql   {:mvn/version "2.7.1368"}
        com.zaxxer/HikariCP                {:mvn/version "6.3.0"}
        org.postgresql/postgresql          {:mvn/version "42.7.7"}
        migratus/migratus                  {:mvn/version "1.6.6"}
        com.github.sikt-no/clj-jwt         {:mvn/version "0.5.109"}
        com.cnuernber/charred             {:mvn/version "1.038"}
        org.jsoup/jsoup                    {:mvn/version "1.21.1"}
        net.dankito.readability4j/readability4j {:mvn/version "1.0.8"}
        org.eclipse.angus/angus-mail      {:mvn/version "2.0.3"}
        com.cognitect.aws/api             {:mvn/version "0.8.741"}
        com.cognitect.aws/endpoints       {:mvn/version "871.2.30.22"}
        com.cognitect.aws/s3              {:mvn/version "871.2.30.22"}
        haikunator/haikunator             {:mvn/version "0.1.0"}}

 :aliases
 {:dev    {:extra-paths ["env/dev/src" "env/dev/resources" "infra/src" "infra/resources"]
           :extra-deps  {integrant/repl                                                   {:mvn/version "0.5.1"}
                         nrepl/nrepl                                                      {:mvn/version "1.4.0"}
                         cider/cider-nrepl                                                {:mvn/version "0.59.0"}
                         io.zonky.test/embedded-postgres                                  {:mvn/version "2.1.0"}
                         io.zonky.test.postgres/embedded-postgres-binaries-darwin-arm64v8 {:mvn/version "17.5.0"}
                         io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64    {:mvn/version "17.5.0"}}
           :main-opts   ["-m" "reader.dev.main"]}

  :test   {:extra-paths ["test" "eval/src" "eval/resources" "env/test/resources" "infra/src" "infra/resources"]
           :extra-deps  {dev.data-star.clojure/http-kit                                   {:mvn/version "1.0.0-RC11"}
                         lambdaisland/kaocha                                              {:mvn/version "1.91.1392"}
                         ring/ring-mock                                                   {:mvn/version "0.6.2"}
                         io.zonky.test/embedded-postgres                                  {:mvn/version "2.1.0"}
                         io.zonky.test.postgres/embedded-postgres-binaries-darwin-arm64v8 {:mvn/version "17.5.0"}
                         io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64    {:mvn/version "17.5.0"}}
           :main-opts   ["-m" "kaocha.runner"]}

  ;; Main-opts-only overlay: combined LAST (after :dev:test) so its REPL
  ;; main-opts win over :test's kaocha runner — otherwise `bb repl` runs the
  ;; suite and exits. Starts an interactive cider nREPL that advertises
  ;; .nrepl-port, so `bb repl` composes with `bb dev`'s reuse path. nrepl/cider
  ;; deps come from :dev, which it's always combined with.
  :nrepl  {:main-opts ["-m" "nrepl.cmdline"
                       "--middleware" "[cider.nrepl/cider-middleware]"
                       "--interactive"]}

  :prod   {:extra-paths ["env/prod/resources"]
           :main-opts   ["-m" "reader.main" "prod.edn"]}

  ;; The evals app — a second entry point in this repo (ADR 0006). It reuses the
  ;; reader's domain + infra namespaces (on :paths) and adds its own source,
  ;; resources, and migrations. Boots reader.eval.main against a profile that
  ;; reuses the infra Integrant keys but wires eval routes/handlers + its own
  ;; port and operator allowlist. Compose with :dev for a local embedded DB
  ;; (clojure -M:dev:eval) or :prod for the deployed subdomain.
  :eval   {:extra-paths ["eval/src" "eval/resources"]
           ;; Datastar SDK (server-driven SSE) — eval-only for now; pulls the core
           ;; sdk transitively. The reader migrates onto it separately.
           :extra-deps  {dev.data-star.clojure/http-kit {:mvn/version "1.0.0-RC11"}}
           :main-opts   ["-m" "reader.eval.main"]}

  :lint   {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2026.04.15"}}
           :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "eval/src" "test" "env" "tasks" "infra"]}

  :cljfmt {:replace-deps {dev.weavejester/cljfmt {:mvn/version "0.16.4"}}
           :main-opts    ["-m" "cljfmt.main"]}

  :build  {:deps      {io.github.clojure/tools.build {:mvn/version "0.10.13"}}
           :ns-default build}}}
