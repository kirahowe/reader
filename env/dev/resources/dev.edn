{:reader.log/publisher {:pretty? true}

 :reader.concerns/http-kit {:opts {:port 3000}}

 :reader.web/csrf {:site-origin "http://localhost:3000"}

 ;; Points at the shared dev Hanko Cloud project (Hanko dashboard → your
 ;; project). `api-url` is the bare project base; the middleware derives the
 ;; JWKS URL (base + /.well-known/jwks.json) from it, and the login element
 ;; (below) talks to the same base — swap both to use your own project.
 ;; `issuer` is intentionally left unset — the project-specific JWKS already
 ;; binds tokens to this project; pin it later if you want defense in depth.
 ;; allowed-emails is the dev invite list. It's a single throwaway identity,
 ;; `test@example.com`, which `bb db:seed` also provisions as a user with a
 ;; populated queue — make a Hanko user for it and sign in to land on real data.
 :reader.auth/middleware {:api-url        "https://61ea63c0-a1ce-428e-8f22-30fa5c5cb455.hanko.io"
                          :allowed-emails #{"test@example.com"}}

 :reader.handlers.auth/login {:api-url "https://61ea63c0-a1ce-428e-8f22-30fa5c5cb455.hanko.io"}

 ;; Dev uses the local-filesystem blob store (no uploads), rooted at the
 ;; configurable const from embedded-db.edn — override there to relocate it.
 :reader.storage/store {:backend :file :root #ig/ref :reader.storage/file-root}

 ;; The :ingest-email handler reads the raw .eml from blob storage (the local
 ;; file store in dev — a REPL can seed it to exercise the path locally).
 :reader.ingest/ingest-email-handler {:storage #ig/ref :reader.storage/store}

 ;; Background worker draining the ingest jobs (manual URL + inbound email).
 :reader.jobs/worker {:datasource        #ig/ref :reader.db/migrator
                      :handlers          {"extract-article" #ig/ref :reader.ingest/extract-article-handler
                                          "ingest-email"    #ig/ref :reader.ingest/ingest-email-handler}
                      :poll-ms           1000
                      :max-attempts      5
                      :backoff-base-secs 10}

 ;; The seeded test user can see the eval dashboard in dev.
 :reader.handlers.admin/extractions {:admin-emails #{"test@example.com"}}

 ;; Placeholder inbound-email domain for dev — no mail is actually received
 ;; until the Cloudflare worker + a real domain land (Slice 5).
 :reader.handlers.settings/show {:inbound-domain "inbox.reader.test"}

 ;; Dev receives inbound email directly: POST a raw .eml to /api/inbound?alias=…
 ;; (no HMAC/worker/R2). Open on localhost; set :token for a reachable tenant.
 :reader.handlers/inbound {:impl :direct :storage #ig/ref :reader.storage/store}}
