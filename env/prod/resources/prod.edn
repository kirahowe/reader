{:reader.concerns/http-kit
 {:opts {:port #env/long ["PORT" 8080]}}

 ;; Prod supplies its own datasource spec; DATABASE_URL is the full Neon
 ;; JDBC URL. Tuned for cost over latency: `minimum-idle 0` drains the pool
 ;; so no idle connection keeps Neon awake; short `idle-timeout` releases
 ;; connections; longer `connection-timeout` absorbs Neon's cold start on
 ;; the first post-suspend request; `initialization-fail-timeout -1` builds
 ;; the pool without opening a connection (first connect is the first query).
 ;;
 ;; The worker polls the jobs table ~1/s, so Neon stays awake while any
 ;; machine runs and autosuspends only once Fly stops the machine.
 ;; Poll-backoff is a separate planned feature.
 :reader.db/datasource
 {:spec {:jdbc-url                    #env "DATABASE_URL"
         :pool-name                   "reader-pool"
         :maximum-pool-size           10
         :minimum-idle                0
         :connection-timeout          30000
         :idle-timeout                30000
         :max-lifetime                300000
         :initialization-fail-timeout -1}}

 ;; `:migrate-on-init? false` makes the component init return the datasource
 ;; without migrating; migrations run out-of-band via the release_command
 ;; (see `reader.migrate`). It still inits to back the #ig/ref deps below.
 :reader.db/migrator
 {:datasource       #ig/ref :reader.db/datasource
  :migrations-path  "migrations"
  :migrate-on-init? false}

 ;; Auth. SITE_ORIGIN is the public origin (e.g. https://reader.example.com)
 ;; for the CSRF check; HANKO_API_URL is the Hanko Cloud project base — the
 ;; middleware derives the JWKS URL (base + /.well-known/jwks.json) from it,
 ;; so there is no separate JWKS env var. ALLOWED_EMAILS is a comma-separated
 ;; invite list, settable as a Fly secret without a redeploy.
 :reader.web/csrf {:site-origin #env "SITE_ORIGIN"}

 :reader.auth/middleware
 {:api-url        #env "HANKO_API_URL"
  :allowed-emails #env/set "ALLOWED_EMAILS"}

 :reader.handlers.auth/login {:api-url #env "HANKO_API_URL"}

 ;; Background worker draining :extract-article jobs (manual URL ingest).
 :reader.jobs/worker {:datasource        #ig/ref :reader.db/migrator
                      :handlers          {"extract-article" #ig/ref :reader.ingest/extract-article-handler}
                      :poll-ms           1000
                      :max-attempts      5
                      :backoff-base-secs 10}

 ;; Eval dashboard admins — empty by default (so the route 404s for everyone);
 ;; set the comma-separated ADMIN_EMAILS Fly secret to grant access, no redeploy.
 :reader.handlers.admin/extractions {:admin-emails #env/set "ADMIN_EMAILS"}}
