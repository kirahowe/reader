;; Local stand-ins for the managed cloud services, for any environment
;; that runs Reader without them (dev, tests, …): an embedded Postgres in
;; place of Neon, and an in-memory blob store in place of Cloudflare R2. A
;; profile that wants the real backends (prod) skips this fragment and
;; supplies its own :reader.db/datasource :spec and :reader.storage/store.
;;
;; Convention: consumers that need the database at startup should
;; `#ig/ref :reader.db/migrator` rather than `:reader.db/datasource`.
;; The migrator key resolves to the same pool but guarantees migrations
;; have applied first — without that ref, Integrant is free to start a
;; consumer in parallel with the migrator and the consumer can race.

{;; Embedded Postgres (io.zonky) and the HikariCP pool over it log through
 ;; SLF4J → Telemere; quiet that infra chatter wherever this fragment is used
 ;; (dev, tests). Prod skips this fragment and keeps the library logs.
 :reader.log/publisher {:min-levels {"io.zonky.*"   :warn
                                     "com.zaxxer.*" :warn}}

 :reader.dev.infra/postgres {}

 :reader.db/datasource
 {:spec #ig/ref :reader.dev.infra/postgres}

 :reader.db/migrator
 {:datasource      #ig/ref :reader.db/datasource
  :migrations-path "migrations"}

 ;; Blob storage standing in for R2: tests use the in-memory store; dev
 ;; overrides to :file (see dev.edn) rooted at this configurable const. The
 ;; path is plain EDN — defaulted here, never hardcoded in code.
 :reader.storage/file-root "/tmp/reader-blobs"
 :reader.storage/store     {:backend :memory}}
