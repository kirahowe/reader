{:reader.log/publisher
 {:pretty? false}

 ;; The cross-cutting middleware stack, outermost-first: request-log wraps
 ;; everything (so it times and records even rejected requests), exception is the
 ;; catch-all 500 gate, then params parsing, then the CSRF and auth gates closest
 ;; to the handler. Each entry is its own component (functions can't be EDN).
 :reader.web.middleware/request-log {}
 :reader.web.middleware/exception   {}
 :reader.web.middleware/parameters  {}

 :reader.concerns.reitit/router
 {:middleware [#ig/ref :reader.web.middleware/request-log
               #ig/ref :reader.web.middleware/exception
               #ig/ref :reader.web.middleware/parameters
               #ig/ref :reader.web/csrf
               #ig/ref :reader.auth/middleware]
  :data
  [["/"                    {:get  {:handler #ig/ref :reader.handlers/home}}]
   ["/login"               {:public? true :get  {:handler #ig/ref :reader.handlers.auth/login}}]
   ["/logout"              {:public? true :post {:handler #ig/ref :reader.handlers.auth/logout}}]
   ["/authors"             {:get  {:handler #ig/ref :reader.handlers.authors/index}}]
   ["/authors/:slug"       {:get  {:handler #ig/ref :reader.handlers.authors/show}}]
   ["/affiliations"        {:get  {:handler #ig/ref :reader.handlers.affiliations/index}}]
   ["/affiliations/:slug"  {:get  {:handler #ig/ref :reader.handlers.affiliations/show}}]
   ["/readables"           {:post {:handler #ig/ref :reader.handlers.readables/create}}]
   ["/queue/:id"           {:get  {:handler #ig/ref :reader.handlers.reader/show}}]
   ["/queue/:id/row"       {:get  {:handler #ig/ref :reader.handlers.readables/row}}]
   ["/queue/:id/archive"   {:post {:handler #ig/ref :reader.handlers.queue/archive}}]
   ["/queue/:id/read"      {:post {:handler #ig/ref :reader.handlers.queue/mark-read}}]
   ["/queue/:id/unread"    {:post {:handler #ig/ref :reader.handlers.queue/mark-unread}}]
   ["/queue/:id/tags"                {:post {:handler #ig/ref :reader.handlers.tags/add}}]
   ["/queue/:id/tags/:tag-id/remove" {:post {:handler #ig/ref :reader.handlers.tags/remove}}]
   ["/settings"            {:get  {:handler #ig/ref :reader.handlers.settings/show}}]
   ["/settings/rotate"     {:post {:handler #ig/ref :reader.handlers.settings/rotate}}]
   ["/admin/extractions"   {:get  {:handler #ig/ref :reader.handlers.admin/extractions}}]
   ["/api/inbound"         {:public? true :post {:handler #ig/ref :reader.handlers/inbound}}]
   ["/health"              {:public? true :get {:handler #ig/ref :reader.handlers/health}}]
   ["/static/*"            {:public? true :handler #ig/ref :reader.handlers/static}]]}

 :reader.concerns.reitit/default-handler {}

 :reader.concerns.reitit/ring-handler
 {:router          #ig/ref :reader.concerns.reitit/router
  :default-handler #ig/ref :reader.concerns.reitit/default-handler}

 :reader.handlers/home               {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.authors/index      {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.authors/show       {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.affiliations/index {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.affiliations/show  {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.reader/show        {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.readables/create   {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.readables/row      {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.queue/archive      {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.queue/mark-read    {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.queue/mark-unread  {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.tags/add           {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.tags/remove        {:datasource #ig/ref :reader.db/migrator}
 ;; The host part of each user's newsletter alias — environment-specific; the
 ;; profiles override this placeholder. Shared by the settings show + rotate
 ;; handlers so both mint at the same domain.
 :reader.inbound/domain "example.invalid"
 ;; Whether inbound email actually delivers here, derived from config (not stored):
 ;; the prod webhook's HMAC secret is set and blob storage is configured. Drives
 ;; the settings page's "not wired yet" note. See reader.inbound.
 :reader.inbound/active? {:hmac-secret #env/opt "INBOUND_HMAC_SECRET"
                          :storage     #ig/ref :reader.storage/store}
 :reader.handlers.settings/show   {:datasource     #ig/ref :reader.db/migrator
                                   :inbound-domain #ig/ref :reader.inbound/domain
                                   :active?        #ig/ref :reader.inbound/active?}
 :reader.handlers.settings/rotate {:datasource     #ig/ref :reader.db/migrator
                                   :inbound-domain #ig/ref :reader.inbound/domain
                                   :active?        #ig/ref :reader.inbound/active?}
 ;; Eval dashboard, admin-gated. admin-emails defaults to none; the dev profile
 ;; admits the seeded user, and prod can override with #env/set "ADMIN_EMAILS".
 :reader.handlers.admin/extractions  {:datasource #ig/ref :reader.db/migrator :admin-emails #{}}
 ;; Inbound-email receiver. One key; each env picks the :impl — :webhook (prod,
 ;; HMAC-verified) or :direct (dev/test/PR, raw .eml). The datasource is shared;
 ;; impl-specific opts (:hmac-secret / :storage / :token) come from the profiles.
 :reader.handlers/inbound            {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers/health {}
 :reader.handlers/static {:root "public"}

 ;; Ingest. `entity-extractor` is the swappable entity abstraction — the deterministic
 ;; metadata reader now, an LLM-backed extractor later behind the same
 ;; EntityResult contract. The worker that drains :extract-article jobs is wired
 ;; in the dev/prod profiles (kept out of the test profile so no background
 ;; thread races the job tests).
 :reader.ingest/entity-extractor {}
 :reader.ingest/extract-article-handler {:extract-entities #ig/ref :reader.ingest/entity-extractor}
 ;; :ingest-email job handler. `storage` is supplied per-environment (the R2
 ;; client in prod, the in-memory stub in dev/test) where that component exists.
 :reader.ingest/ingest-email-handler {}
 ;; Explicit, version-gated repair path for already-stored newsletters. It is
 ;; never scheduled merely by booting/deploying; enqueue stale rows deliberately
 ;; with reader.ingest/enqueue-newsletter-reprocessing!.
 :reader.ingest/reprocess-newsletter-handler {}
 ;; :extract-paper job handler. Fetches the OpenAlex graph + arXiv HTML body over
 ;; the network (free APIs, no config) and upserts the canonical entity graph.
 :reader.papers/extract-paper-handler {}

 ;; Auto-tagging. `tagger` is the swappable infer-tags abstraction (LLM-backed),
 ;; and `embed` the embedder; both are pluggable reader.ai clients whose
 ;; endpoints/creds come from the profiles, and both are nil until configured.
 ;; The job gates on `tagger`/`embed`: with neither it runs the stubs (dev/test)
 ;; or skips + reschedules (prod, via :require-model?), so stub data never lands
 ;; in the shared baseline. The :tag-readable handler is registered with the
 ;; worker in the dev/prod profiles.
 :reader.ai/complete {}
 :reader.ai/embed    {}
 :reader.ingest.tag/tagger {:complete #ig/ref :reader.ai/complete}
 :reader.ingest.tag-job/handler {:tagger #ig/ref :reader.ingest.tag/tagger
                                 :embed  #ig/ref :reader.ai/embed}

 ;; Auth. jwks-url, issuer, api-url, allowed-emails, and the CSRF site-origin
 ;; are environment-specific and supplied by the dev/test/prod profiles.
 ;; allowed-emails gates *provisioning* only: an unseen identity is admitted
 ;; just when its address is listed (an unset/empty list provisions no one).
 ;; It is not an ongoing check — a user already in the `users` table is let in
 ;; regardless of the current list, so revoking access means deleting the row,
 ;; not editing this set.
 :reader.web/csrf {}
 :reader.auth/middleware      {:datasource #ig/ref :reader.db/migrator}
 :reader.handlers.auth/login  {}
 :reader.handlers.auth/logout {}

 :reader.concerns/http-kit
 {:handler #ig/ref :reader.concerns.reitit/ring-handler
  :opts    {:port 8080 :ip "0.0.0.0"}}}
